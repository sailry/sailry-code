{
  "tools": [
    {
      "name": "git_status",
      "legacy_package": "git",
      "description": "Read Git status without modifying the index or checkout. When HEAD points to a commit, use head and index_revision from this result to protect operations that copy uncommitted changes. Omit worktree for this turn's directory, or select a registered worktree ID from list_worktrees in the same project.",
      "parameters": {
        "type": "object",
        "properties": {
          "worktree": {
            "type": [
              "string",
              "null"
            ],
            "description": "Registered worktree ID in this turn's project; omit for the current worktree"
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "operation": "git.status",
      "action": "status",
      "stream_read": true,
      "contexts": [
        "workspace"
      ],
      "presentation": "summary",
      "display": {
        "label": "Git status",
        "locales": {
          "zh-CN": "Git 状态",
          "zh-TW": "Git 狀態",
          "ja": "Git の状態",
          "ko": "Git 상태",
          "fr": "État Git",
          "de": "Git-Status",
          "es": "Estado de Git",
          "pt-BR": "Estado do Git",
          "ru": "Состояние Git",
          "en": "Git status"
        },
        "icon": {
          "svg": "<svg\n    xmlns=\"http://www.w3.org/2000/svg\"\n    width=\"24\"\n    height=\"24\"\n    viewBox=\"0 0 24 24\"\n    fill=\"none\"\n    stroke=\"currentColor\"\n    stroke-width=\"2\"\n    stroke-linecap=\"round\"\n    stroke-linejoin=\"round\"\n><rect x=\"16\" y=\"16\" width=\"6\" height=\"6\" rx=\"1\" /><rect\n        x=\"2\"\n        y=\"16\"\n        width=\"6\"\n        height=\"6\"\n        rx=\"1\"\n    /><rect x=\"9\" y=\"2\" width=\"6\" height=\"6\" rx=\"1\" /><path\n        d=\"M5 16v-3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v3\"\n    /><path d=\"M12 12V8\" /></svg>"
        },
        "output": {
          "preview": {
            "parts": [
              {
                "rows": {
                  "value": {
                    "source": "result",
                    "path": "/data/entries"
                  },
                  "text": {
                    "parts": [
                      {
                        "text": "U",
                        "when": {
                          "all": [
                            {
                              "value": {
                                "source": "item",
                                "path": "/conflicted"
                              },
                              "equals": true
                            }
                          ]
                        }
                      },
                      {
                        "text": "?",
                        "when": {
                          "all": [
                            {
                              "value": {
                                "source": "item",
                                "path": "/conflicted"
                              },
                              "equals": false
                            },
                            {
                              "value": {
                                "source": "item",
                                "path": "/untracked"
                              },
                              "equals": true
                            }
                          ]
                        }
                      },
                      {
                        "text": "A",
                        "when": {
                          "all": [
                            {
                              "value": {
                                "source": "item",
                                "path": "/conflicted"
                              },
                              "equals": false
                            },
                            {
                              "value": {
                                "source": "item",
                                "path": "/untracked"
                              },
                              "equals": false
                            },
                            {
                              "value": {
                                "source": "item",
                                "path": "/staged"
                              },
                              "equals": "added"

                                "source": "item",
                                "path": "/unstaged"
                              },
                              "equals": "modified"
                            }
                          ]
                        }
                      },
                      {
                        "text": "D",
                        "when": {
                          "all": [
                            {
                              "value": {
                                "source": "item",
                                "path": "/conflicted"
                              },
                              "equals": false
                            },
                            {
                              "value": {
                                "source": "item",

                  "separator": "\n"
                }
              }
            ]
          },
          "notices": [
            {
              "message": {
                "label": "Directory",
                "locales": {
                  "zh-CN": "普通目录"
                }
              },
              "when": {
                "any": [
                  {
                    "value": {
                      "source": "result",
                      "path": "/data/kind"
                    },
                    "equals": "directory"
                  }
                ]
              }
            }
          ]

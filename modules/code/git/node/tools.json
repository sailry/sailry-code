                            {
                              "value": {
                                "source": "item",
                                "path": "/untracked"
                              },
                              "equals": false
                            },
                            {
                              "value": {
                                "source": "item",
                                "path": "/staged"
                              },
                              "equals": "renamed"
                            }
                          ]
                        }
                      },
                      {

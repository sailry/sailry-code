    },
    {
      "name": "git_diff",
      "legacy_package": "git",
      "description": "Read the bounded Git diff of one relative file path. Select staged, unstaged, or all changes (the default). Omit worktree for this turn's directory, or select a registered worktree ID from list_worktrees in the same project.",
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "Relative to the selected worktree"
          },
          "scope": {
            "type": "string",
            "enum": [
              "all",
              "staged",
              "unstaged"
            ]
          },
          "worktree": {
            "type": [
              "string",
              "null"
            ],
            "description": "Registered worktree ID in this turn's project; omit for the current worktree"
          }
        },
        "required": [
          "path"
        ],
        "additionalProperties": false
      },
      "operation": "git.diff",
      "action": "diff",
      "stream_read": true,
      "contexts": [
        "workspace"
      ],
      "presentation": "details",
      "display": {
        "label": "View diff",
        "locales": {
          "zh-CN": "查看差异",
          "zh-TW": "檢視差異",
          "ja": "差分を見る",
          "ko": "차이 보기",
          "fr": "Voir les différences",
          "de": "Diff anzeigen",
          "es": "Ver diferencias",
          "pt-BR": "Ver diferenças",
          "ru": "Показать изменения",
          "en": "View diff"
        },
        "icon": {
          "svg": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n  <path d=\"M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z\"/>\n  <path d=\"M14 2v6h6M8 12h6M11 9v6M8 18h6\"/>\n</svg>"
        },
        "input": {
          "summary": {
            "path": "/path",
            "code": true
          }
        },
        "output": {
          "preview": {
            "parts": [
              {
                "value": {
                  "source": "result",
                  "path": "/data/text"
                }
              }
            ]
          },
          "body": {
            "text": {
              "source": "result",
              "path": "/data/text"
            },
            "path": {
              "source": "arguments",
              "path": "/path"
            },
            "diff": {
              "format": "unified",
              "when": {
                "any": [
                  {
                    "value": {
                      "source": "result",
                      "path": "/data/binary"
                    },
                    "equals": false
                  }
                ]
              }
            }
          },
          "notices": [
            {
              "message": {
                "label": "Binary file",
                "locales": {
                  "zh-CN": "二进制文件"
                }
              },
              "when": {
                "any": [
                  {
                    "value": {
                      "source": "result",
                      "path": "/data/binary"
                    },
                    "equals": true
                  }
                ]
              }
            }
          ]
        }
      }
    }

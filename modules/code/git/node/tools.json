                            {
                              "value": {
                                "source": "item",
                                "path": "/untracked"
                              },
                              "equals": false
                            },
                            {
                              "value": {
                                "source": "item",
                                "path": "/staged"
                              },
                              "equals": "modified"
                            }
                          ]
                        }
                      },
                      {
                        "text": "D",
                        "when": {
                          "all": [
                            {
